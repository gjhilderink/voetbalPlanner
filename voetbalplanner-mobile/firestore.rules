rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // FlutterFlow test/preview-toegang — laten staan.
    match /{document=**} {
      allow read, write: if request.auth.token.email.matches("firebase@flutterflow.io");
    }

    // Chat-collecties.
    //
    // De app gebruikt Firebase ANONYMOUS auth (vereist o.a. voor NavBar-navigatie);
    // de echte autorisatie loopt via de Laravel-backend (Sanctum). De anonieme uid
    // heeft geen relatie met conversationId/teamId, dus we autoriseren op
    // "ingelogd bij Firebase".
    //
    // De FlutterFlow-auto-gegenereerde rules eisten auth.uid == conversationId /
    // teamId / groupId (NOOIT waar) plus `allow write: if false`. Daardoor faalde
    // elke chat-read/write met permission-denied: verzenden kapot, en de
    // ChatsPage-laadketen brak op de geweigerde reads waardoor leden/staffgroepen
    // leeg bleven.
    match /chatConversations/{document} { allow read, write: if request.auth != null; }
    match /chatMessages/{document}      { allow read, write: if request.auth != null; }
    match /chatGroups/{document}        { allow read, write: if request.auth != null; }
    match /groupMessages/{document}     { allow read, write: if request.auth != null; }
    match /teamChats/{document}         { allow read, write: if request.auth != null; }
    match /directMessages/{document}    { allow read, write: if request.auth != null; }

    // appUsers + fcm_tokens-subcollectie (FlutterFlow push notifications).
    match /appUsers/{document=**}       { allow read, write: if request.auth != null; }

    // FlutterFlow user-docs (gekeyd op de Firebase-uid).
    match /users/{document} {
      allow read, write: if request.auth.uid == document;
    }
  }
}
